api.asgard.website {
	encode zstd gzip

	@midnight_feedback path /v2/feedback /v2/feedback/* /v2/admin/feedback /v2/admin/feedback/*
	handle @midnight_feedback {
		reverse_proxy 127.0.0.1:8798 {
			header_up X-Midnight-Client-IP {remote_host}
		}
	}

	@midnight_online path /v2/auth/* /v2/me /v2/me/* /v2/events/* /v2/attempts /v2/attempts/* /v2/statistics /v2/statistics/*
	handle @midnight_online {
		reverse_proxy 127.0.0.1:8799 {
			header_up X-Midnight-Client-IP {remote_host}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8787
	}
}
