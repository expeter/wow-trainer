[Unit]
Description=Midnight Season 2 guild feedback intake
After=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=midnight-feedback
WorkingDirectory=/var/lib/midnight-feedback
EnvironmentFile=/etc/midnight-feedback.env
Environment=MIDNIGHT_FEEDBACK_HOST=127.0.0.1
Environment=MIDNIGHT_FEEDBACK_PORT=8798
Environment=MIDNIGHT_FEEDBACK_STORAGE=/var/lib/midnight-feedback/reports
ExecStart=/usr/bin/node /opt/midnight-feedback/server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
